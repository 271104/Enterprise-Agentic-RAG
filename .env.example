# Required backend integrations
GROQ_API_KEY=
PORTKEY_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# Embeddings: "gemini" or "local". Local requires sentence-transformers.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# Optional observability (disabled unless explicitly enabled)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-rag
LOGFIRE_TOKEN=

# Streamlit UI backend URL
BACKEND_URL=http://127.0.0.1:8000

# Optional evaluation judge key (falls back to GROQ_API_KEY)
JUDGE_GROQ=
